{
  "name": "@arkeytyp/valu-api",
  "version": "2.0.0",
  "description": "A package for developing iframe applications for Valu Social. Allows invoking functions of registered Valu applications and subscribing to events, as well as other features that enable developers creating own ifram apps for the value social",
  "main": "src/ValuApi.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "sync:manifests": "node scripts/sync-manifests.mjs",
    "measure:consumers": "node scripts/measure-consumers.mjs",
    "measure:api-pointers": "node scripts/measure-api-pointers.mjs",
    "test": "npm run check:generated && node --test \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit --strict --skipLibCheck types/valu-api.d.ts types/valu-services.d.ts && tsc -p test/types/consumer"
  },
  "types": "./types/valu-api.d.ts",
  "exports": {
    ".": {
      "types": "./types/valu-api.d.ts",
      "default": "./src/ValuApi.js"
    },
    "./types/valu-services": {
      "types": "./types/valu-services.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "keywords": ["valu", "api", "iframe", "valu social", "multiverse"],
  "author": "Stanislav Osipov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkeytyp/valu-api.git"
  }
}
