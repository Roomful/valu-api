{
  // A consumer of the package, as one sees it: strict, declaration files checked
  // (no skipLibCheck), and the package name resolved through `paths` to this
  // repository's root, the way node_modules/@arkeytyp/valu-api would be.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@arkeytyp/valu-api": ["../../.."],
      "@arkeytyp/valu-api/*": ["../../../*"]
    }
  },
  "files": ["consumer.ts"]
}
